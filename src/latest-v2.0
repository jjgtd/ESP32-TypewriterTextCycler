#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
#define SCREEN_ADDRESS 0x3C

// Pin layout for ESP32-C3 Super Mini
#define SCL_PIN 8  // GPIO 8
#define SDA_PIN 9  // GPIO 9

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// 8x8 Heart Icon Bitmap
const unsigned char PROGMEM heart_bmp[] = {
  0b00000000,
  0b01100110,
  0b11111111,
  0b11111111,
  0b01111110,
  0b00111100,
  0b00011000,
  0b00000000
};

// Prints text letter-by-letter with a typewriter effect
void printTypewriter(const char* text, int delayMs = 30) {
  for (int i = 0; text[i] != '\0'; i++) {
    display.print(text[i]);
    display.display();
    delay(delayMs);
  }
}

// Displays a multi-line pickup line and draws a heart at the end
void showPickupLine(const char* lines[], int lineCount) {
  display.clearDisplay();
  
  // Bottom half constraints: Y starts at 32, max 4 lines (8px height per line)
  int lineSpacing = 8;
  int startY = 32;

  for (int i = 0; i < lineCount; i++) {
    display.setCursor(0, startY + (i * lineSpacing));
    printTypewriter(lines[i], 35);
    delay(100);
  }

  // Calculate heart coordinates based on final cursor position
  int heartX = display.getCursorX() + 2;
  int heartY = display.getCursorY();
  
  // Ensure heart Y stays within the bottom half (32 to 56)
  if (heartY < 32) heartY = 32;

  // Handle line wrapping cleanly if text reaches right margin
  if (heartX > 118) {
    heartX = 0;
    heartY += lineSpacing;
  }

  // Clamp heart Y so an 8px bitmap never draws past Y=63
  if (heartY > 56) {
    heartY = 56;
  }

  display.drawBitmap(heartX, heartY, heart_bmp, 8, 8, SSD1306_WHITE);
  display.display();

  // Hold text on screen before transitioning
  delay(4000);
}

void setup() {
  Wire.begin(SDA_PIN, SCL_PIN);

  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    for (;;); // Lockup if OLED isn't detected
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
}

void loop() {
  // 1. Resistor
  const char* resistor[] = {
    "Are you a resistor?",
    "Cuz you don't just",
    "control current...",
    "you control my heart"
  };
  showPickupLine(resistor, 4);

  // 2. Oscilloscope
  const char* oscilloscope[] = {
    "Are you an",
    "oscilloscope?",
    "My heart rate spikes",
    "when I look at you."
  };
  showPickupLine(oscilloscope, 4);

  // 3. Voltage Source
  const char* voltageSource[] = {
    "Are you a",
    "voltage source?",
    "Cuz you create a",
    "potential difference"
  };
  showPickupLine(voltageSource, 4);

  // 4. Final Personal Message - Page 1
  const char* finalPart1[] = {
    "Mathis might have",
    "asked you to be the",
    "Hiro to his",
    "Midoriya, but with"
  };
  showPickupLine(finalPart1, 4);

  // 4. Final Personal Message - Page 2
  const char* finalPart2[] = {
    "you, I don't need",
    "One For All--",
    "you're already my",
    "entire universe."
  };
  showPickupLine(finalPart2, 4);
}
